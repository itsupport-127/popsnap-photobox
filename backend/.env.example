PORT=4000

# Folder tempat SEMUA hasil foto (final + mentah) disimpan PERMANEN di PC ini.
# Default: folder "output" di dalam project backend. Ganti sesuai kebutuhan,
# misal mau taruh di Desktop biar gampang dibuka:
# OUTPUT_DIR=C:\Users\NamaKamu\Desktop\POPSNAP-Photos
OUTPUT_DIR=

# --- Sync ke server pusat (opsional, buat multi-toko) ---
# Kosongkan kalau toko ini berdiri sendiri / belum ada server pusat.
# Isi kalau kamu sudah deploy cloud-dashboard/ (lihat cloud-dashboard/README.md)
CLOUD_SYNC_URL=
CLOUD_SYNC_API_KEY=

# Alamat IP yang dipakai buat URL gambar template & link download QR.
# Default: auto-detect IP LAN PC ini. Cuma isi manual kalau auto-detect
# salah pilih (misal PC kamu punya lebih dari 1 kartu jaringan aktif).
# PUBLIC_HOST=192.168.1.10

# --- Midtrans QRIS ---
# Daftar dulu di https://dashboard.sandbox.midtrans.com untuk akun SANDBOX (gratis, buat testing).
# Ambil Server Key & Client Key dari Settings > Access Keys.
# Kalau ini dikosongkan, backend otomatis pakai mode simulasi (tidak crash).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
